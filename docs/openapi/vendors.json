{
  "openapi": "3.0.3",
  "info": {
    "title": "MDM 협력사 API",
    "description": "MDM 협력사 정보 조회/등록 API (api_code: `MDM-VENDOR`).\nCitizen Developer API 포털에서 발급받은 PAT(Personal Access Token)를\n`Authorization: Bearer hdpat_<tokenId>_<secret>` 헤더로 전달해 호출합니다.\n각 오퍼레이션에 필요한 PAT 스코프는 `x-required-scope`에 명시되어 있습니다.\n",
    "version": "1.0.0",
    "contact": {
      "name": "MDM운영팀"
    }
  },
  "servers": [
    {
      "url": "http://localhost:9080",
      "description": "Citizen API Portal Gateway (APISIX, local dev)"
    }
  ],
  "tags": [
    {
      "name": "vendors",
      "description": "협력사(Vendor) 조회/등록"
    }
  ],
  "security": [
    {
      "PatAuth": []
    }
  ],
  "paths": {
    "/capi/v1/vendors": {
      "get": {
        "operationId": "listVendors",
        "summary": "협력사 목록 조회",
        "tags": [
          "vendors"
        ],
        "x-required-scope": "capi.vendor.read",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "협력사 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Vendor"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "page": {
                      "type": "integer"
                    },
                    "size": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/QuotaExceeded"
          }
        }
      },
      "post": {
        "operationId": "createVendor",
        "summary": "협력사 등록",
        "tags": [
          "vendors"
        ],
        "x-required-scope": "capi.vendor.write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VendorCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "등록된 협력사",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Vendor"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/QuotaExceeded"
          }
        }
      }
    },
    "/capi/v1/vendors/{vendorId}": {
      "get": {
        "operationId": "getVendor",
        "summary": "협력사 단건 조회",
        "tags": [
          "vendors"
        ],
        "x-required-scope": "capi.vendor.read",
        "parameters": [
          {
            "name": "vendorId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "v001"
          }
        ],
        "responses": {
          "200": {
            "description": "협력사 상세",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Vendor"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "존재하지 않는 협력사 ID (업스트림이 그대로 반환)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpstreamNotFound"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/QuotaExceeded"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PatAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "hdpat_<tokenId:12>_<secret:43>",
        "description": "포털에서 발급한 PAT. 오퍼레이션별 x-required-scope에 해당하는 스코프가 승인되어 있어야 합니다."
      }
    },
    "schemas": {
      "Vendor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "v001"
          },
          "name": {
            "type": "string",
            "example": "삼성전자㈜"
          },
          "code": {
            "type": "string",
            "example": "S001"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          },
          "tier": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ]
          }
        }
      },
      "VendorCreateRequest": {
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ],
            "default": "ACTIVE"
          },
          "tier": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ]
          }
        }
      },
      "UpstreamNotFound": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "NOT_FOUND"
              },
              "message": {
                "type": "string",
                "example": "Vendor v999 not found"
              }
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem+json — 게이트웨이(pat-auth/pat-quota)가 발생시키는 에러 포맷.",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://cdp-portal.hd.com/errors/CDP-1003"
          },
          "title": {
            "type": "string",
            "example": "Required scope not granted"
          },
          "status": {
            "type": "integer",
            "example": 403
          },
          "code": {
            "type": "string",
            "example": "CDP-1003"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "PAT 누락/무효/만료 (CDP-1001/1002) 또는 인가 서비스 장애 (CDP-2001)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "필요한 스코프 미승인 (CDP-1003) 또는 허용되지 않은 IP (CDP-1006)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "QuotaExceeded": {
        "description": "호출 쿼터/레이트 초과 (CDP-1004)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
